{
  "name": "requirement-model-site",
  "private": true,
  "version": "0.1.0",
  "description": "req site の責務別 ES modules を検査し、配布用 bundle を生成する",
  "type": "module",
  "scripts": {
    "build": "node tools/build-site.mjs",
    "check:bundle": "node tools/build-site.mjs --check",
    "lint": "node --check tools/build-site.mjs && tsc --noEmit",
    "test": "npm run check:bundle && node --import tsx --test tests/js/*.test.mjs",
    "bench": "node --import tsx tests/js/bench.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
