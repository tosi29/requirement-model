digraph requirements {
    rankdir=BT;
    node [fontname="sans-serif", style=filled, fillcolor=white];
    edge [fontname="sans-serif", fontsize=10];
    subgraph cluster_Goal {
        label="Goal";
        rank=same;
        n1 [shape=hexagon, label="Goal-1 [Goal]\\n要求の不備が後工程で見つかることによる手戻りを減らす"];
        n2 [shape=hexagon, label="Goal-2 [Goal]\\n要求を変えるたびに繰り返される影響調査の負荷を減らす"];
        n3 [shape=hexagon, label="Goal-3 [Goal]\\n要求の理解が書き手に依存する度合いを下げる"];
    }
    subgraph cluster_Need {
        label="Need";
        rank=same;
        n4 [shape=ellipse, label="Need-1 [Need]\\n要求を書く人は、書き方の誤りをレビュー会の前に自分で見つけたい"];
        n5 [shape=ellipse, label="Need-2 [Need]\\n要求をレビューする人は、どこにも繋がっていない要求が残っていないかを知りたい"];
        n6 [shape=ellipse, label="Need-3 [Need]\\n要求を変更する人は、その変更がどこまで波及するのかを変更前に把握したい"];
        n7 [shape=ellipse, label="Need-4 [Need]\\n変更を審査する人は、差分から要求グラフの何が変わったのかを読み取りたい"];
        n8 [shape=ellipse, label="Need-5 [Need]\\n要求の判断を LLM に委ねる人は、判断に要る文脈を欠けなく渡したい"];
        n9 [shape=ellipse, label="Need-6 [Need]\\n要求を読む関係者は、ツールを入れずに要求の全体像と個々のトレースを見たい"];
        n10 [shape=ellipse, label="Need-7 [Need]\\n要求を管理する人は、モデル全体の充足率と成熟度の分布を数値で把握したい"];
        n11 [shape=ellipse, label="Need-8 [Need]\\nCI を回す人は、既知で意図的な指摘を残したまま、新しい指摘だけで失敗させたい"];
    }
    subgraph cluster_Requirements {
        label="Requirements";
        subgraph cluster_group_validation {
            label="検証";
            rank=same;
            n12 [shape=box, label="FR-1 [FunctionalRequirement]\\n定義ファイルを実行せず、AST からノード集合を復元すること"];
            n23 [shape=box, label="FR-2 [FunctionalRequirement]\\nノードの必須属性・id の重複・語尾規則の違反を、定義した行番号とともに報告す…"];
            n31 [shape=box, label="FR-3 [FunctionalRequirement]\\n型規則に違反するエッジ・参照切れ・階層エッジ (refines / part_…"];
            n32 [shape=box, label="FR-4 [FunctionalRequirement]\\nどの Goal にも到達できない FR・satisfies されない Need…"];
            n33 [shape=box, label="FR-5 [FunctionalRequirement]\\n辞書に載っている曖昧語を含む本文を warning として報告すること"];
            n34 [shape=box, label="FR-6 [FunctionalRequirement]\\nノード属性 suppress に書いた (チェックコード, 理由) の組で、そ…"];
            n35 [shape=box, label="FR-7 [FunctionalRequirement]\\n指摘の重大度に応じた終了コードを返し、CI にそのまま置けるようにすること"];
            n41 [shape=note, label="Constraint-1 [Constraint]\\n定義ファイルを実行しないこと"];
        }
        subgraph cluster_group_analysis {
            label="影響分析・LLM連携";
            rank=same;
            n36 [shape=box, label="FR-8 [FunctionalRequirement]\\n指定したノードの上流と下流を辿り、影響部分グラフを抽出すること"];
            n37 [shape=box, label="FR-9 [FunctionalRequirement]\\n影響部分グラフの本文と根拠を、LLM に渡せる書式に整形して出力すること"];
            n13 [shape=box, label="FR-10 [FunctionalRequirement]\\ngit の前版の定義ファイルを読み、ノード単位とフィールド単位の構造差分と、変…"];
            n43 [shape=note, label="Constraint-3 [Constraint]\\n履歴とレビューの基盤を Git に置き、RDB と外部ストレージを持たないこと"];
            n45 [shape=note, label="Constraint-5 [Constraint]\\nLLM API を直接呼ばず、LLM に渡す文脈の生成までに留めること"];
        }
        subgraph cluster_group_presentation {
            label="出力と閲覧";
            rank=same;
            n14 [shape=box, label="FR-11 [FunctionalRequirement]\\nモデルから仕様書とトレーサビリティ表を生成すること"];
            n15 [shape=box, label="FR-12 [FunctionalRequirement]\\n外部の実行環境を要さない 1 枚の HTML として、閲覧用サイトを生成すること"];
            n16 [shape=box, label="FR-13 [FunctionalRequirement]\\n図の初期表示でグラフ全体を 1 画面に収め、この表示は俯瞰の用途に限ること"];
            n17 [shape=box, label="FR-14 [FunctionalRequirement]\\n閲覧用サイトに表形式の一覧を設け、列見出しで並べ替えられるようにし、同値の行の…"];
            n18 [shape=box, label="FR-15 [FunctionalRequirement]\\n選択したノードと表示の絞り込みを URL に載せ、同じ画面を相手にも出せるよう…"];
            n19 [shape=box, label="FR-16 [FunctionalRequirement]\\nノード数・エッジ数・充足率・曖昧語密度を数え、判定を伴わない形で出すこと"];
            n24 [shape=box, label="FR-20 [FunctionalRequirement]\\nMCP サーバとして validate / explain / impact …"];
            n27 [shape=box, label="FR-23 [FunctionalRequirement]\\nGraphviz のレイアウトを用いて SVG の図を書き出すこと"];
            n28 [shape=box, label="FR-24 [FunctionalRequirement]\\n記号だけが異なる id を持つノードを、図の上でも別のノードとして描き分けること"];
            n29 [shape=box, label="FR-25 [FunctionalRequirement]\\n源泉を図に描かず、参照元ノードの属性として引用文・位置・引用元まで出すこと"];
            n30 [shape=box, label="FR-26 [FunctionalRequirement]\\n選択したノードの近傍だけを図に描くフォーカス表示を設けること"];
            n38 [shape=box, label="QR-1 [QualityRequirement]\\n図に描かれるノードのラベルが読める倍率 (0.5 倍以上) を保つこと"];
            n39 [shape=box, label="QR-3 [QualityRequirement]\\n閲覧用サイトが書き出す図と CLI が出す図を、一字一句一致させること"];
            n40 [shape=box, label="QR-4 [QualityRequirement]\\n閲覧用サイトのすべての操作要素を、キーボードだけで辿れるようにすること"];
            n42 [shape=note, label="Constraint-2 [Constraint]\\n実行時の依存を pydantic だけに保つこと"];
            n44 [shape=note, label="Constraint-4 [Constraint]\\n公開する閲覧用サイトを、外部への通信なしで表示できるようにすること"];
        }
        subgraph cluster_group___unclassified__ {
            label="未分類";
            rank=same;
            n20 [shape=box, label="FR-17 [FunctionalRequirement]\\n正規化 JSON と Mermaid / DOT の図を出力すること"];
            n21 [shape=box, label="FR-18 [FunctionalRequirement]\\n構造差分を Markdown で出力し、PR コメントに貼れる形にすること"];
            n22 [shape=box, label="FR-19 [FunctionalRequirement]\\nプロジェクト固有の曖昧語と、検査ごとの有効・無効を設定ファイルで宣言できるよう…"];
            n25 [shape=box, label="FR-21 [FunctionalRequirement]\\n測定不能な QR・status の後退・id の命名規則違反を検査すること"];
            n26 [shape=box, label="FR-22 [FunctionalRequirement]\\n指摘を SARIF 形式で出力し、GitHub Code Scanning に…"];
        }
    }
    n1 -> n4 [label="motivates"];
    n1 -> n5 [label="motivates"];
    n1 -> n11 [label="motivates"];
    n2 -> n6 [label="motivates"];
    n2 -> n7 [label="motivates"];
    n3 -> n8 [label="motivates"];
    n3 -> n9 [label="motivates"];
    n3 -> n10 [label="motivates"];
    n12 -> n4 [label="satisfies"];
    n13 -> n7 [label="satisfies"];
    n14 -> n9 [label="satisfies"];
    n15 -> n9 [label="satisfies"];
    n16 -> n9 [label="satisfies"];
    n16 -> n15 [label="refines"];
    n17 -> n9 [label="satisfies"];
    n17 -> n15 [label="refines"];
    n18 -> n9 [label="satisfies"];
    n18 -> n15 [label="refines"];
    n19 -> n10 [label="satisfies"];
    n20 -> n9 [label="satisfies"];
    n21 -> n7 [label="satisfies"];
    n21 -> n13 [label="refines"];
    n22 -> n4 [label="satisfies"];
    n23 -> n4 [label="satisfies"];
    n24 -> n8 [label="satisfies"];
    n25 -> n5 [label="satisfies"];
    n26 -> n11 [label="satisfies"];
    n27 -> n9 [label="satisfies"];
    n28 -> n9 [label="satisfies"];
    n29 -> n9 [label="satisfies"];
    n29 -> n8 [label="satisfies"];
    n30 -> n9 [label="satisfies"];
    n30 -> n15 [label="refines"];
    n31 -> n5 [label="satisfies"];
    n32 -> n5 [label="satisfies"];
    n33 -> n4 [label="satisfies"];
    n34 -> n11 [label="satisfies"];
    n35 -> n11 [label="satisfies"];
    n36 -> n6 [label="satisfies"];
    n37 -> n8 [label="satisfies"];
    n37 -> n36 [label="refines"];
    n38 -> n30 [label="qualifies"];
    n39 -> n15 [label="qualifies"];
    n40 -> n15 [label="qualifies"];
    n41 -> n12 [label="constrains"];
    n41 -> n13 [label="constrains"];
    n42 -> n24 [label="constrains"];
    n42 -> n27 [label="constrains"];
    n43 -> n13 [label="constrains"];
    n44 -> n15 [label="constrains"];
    n45 -> n37 [label="constrains"];
    n45 -> n24 [label="constrains"];
}
