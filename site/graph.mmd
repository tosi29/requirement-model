flowchart TD
    subgraph band_Goal[Goal]
        direction LR
        n1{{"<b>Goal-1</b> [Goal]<br/>要求の不備が後工程で見つかることによる手戻りを減らす"}}
        n2{{"<b>Goal-2</b> [Goal]<br/>要求を変えるたびに繰り返される影響調査の負荷を減らす"}}
        n3{{"<b>Goal-3</b> [Goal]<br/>要求の理解が書き手に依存する度合いを下げる"}}
    end
    subgraph band_Need[Need]
        direction LR
        n4("<b>Need-1</b> [Need]<br/>要求を書く人は、書き方の誤りをレビュー会の前に自分で見つけたい")
        n5("<b>Need-2</b> [Need]<br/>要求をレビューする人は、どこにも繋がっていない要求が残っていないかを知りたい")
        n6("<b>Need-3</b> [Need]<br/>要求を変更する人は、その変更がどこまで波及するのかを変更前に把握したい")
        n7("<b>Need-4</b> [Need]<br/>変更を審査する人は、差分から要求グラフの何が変わったのかを読み取りたい")
        n8("<b>Need-5</b> [Need]<br/>要求の判断を LLM に委ねる人は、判断に要る文脈を欠けなく渡したい")
        n9("<b>Need-6</b> [Need]<br/>要求を読む関係者は、ツールを入れずに要求の全体像と個々のトレースを見たい")
        n10("<b>Need-7</b> [Need]<br/>要求を管理する人は、モデル全体の充足率と成熟度の分布を数値で把握したい")
        n11("<b>Need-8</b> [Need]<br/>CI を回す人は、既知で意図的な指摘を残したまま、新しい指摘だけで失敗させたい")
    end
    subgraph band_Requirements[Requirements]
        direction LR
        subgraph group_validation[検証]
            direction TB
            n12["<b>FR-1</b> [FunctionalRequirement]<br/>定義ファイルを実行せず、AST からノード集合を復元すること"]
            n23["<b>FR-2</b> [FunctionalRequirement]<br/>ノードの必須属性・id の重複・語尾規則の違反を、定義した行番号とともに報告す…"]
            n32["<b>FR-3</b> [FunctionalRequirement]<br/>型規則に違反するエッジ・参照切れ・階層エッジ (refines / part_…"]
            n33["<b>FR-4</b> [FunctionalRequirement]<br/>どの Goal にも到達できない FR・satisfies されない Need…"]
            n34["<b>FR-5</b> [FunctionalRequirement]<br/>辞書に載っている曖昧語を含む本文を warning として報告すること"]
            n35["<b>FR-6</b> [FunctionalRequirement]<br/>ノード属性 suppress に書いた (チェックコード, 理由) の組で、そ…"]
            n36["<b>FR-7</b> [FunctionalRequirement]<br/>指摘の重大度に応じた終了コードを返し、CI にそのまま置けるようにすること"]
            n31["<b>FR-27</b> [FunctionalRequirement]<br/>ノード型ごとに意味のある status だけを許可し、合意状態の参照整合を検査…"]
            n42[["<b>Constraint-1</b> [Constraint]<br/>定義ファイルを実行しないこと"]]
        end
        subgraph group_analysis[影響分析・LLM連携]
            direction TB
            n37["<b>FR-8</b> [FunctionalRequirement]<br/>指定したノードの上流と下流を辿り、影響部分グラフを抽出すること"]
            n38["<b>FR-9</b> [FunctionalRequirement]<br/>影響部分グラフの本文と根拠を、LLM に渡せる書式に整形して出力すること"]
            n13["<b>FR-10</b> [FunctionalRequirement]<br/>git の前版の定義ファイルを読み、ノード単位とフィールド単位の構造差分と、変…"]
            n44[["<b>Constraint-3</b> [Constraint]<br/>履歴とレビューの基盤を Git に置き、RDB と外部ストレージを持たないこと"]]
            n46[["<b>Constraint-5</b> [Constraint]<br/>LLM API を直接呼ばず、LLM に渡す文脈の生成までに留めること"]]
        end
        subgraph group_presentation[出力と閲覧]
            direction TB
            n14["<b>FR-11</b> [FunctionalRequirement]<br/>モデルから仕様書とトレーサビリティ表を生成すること"]
            n15["<b>FR-12</b> [FunctionalRequirement]<br/>外部の実行環境を要さない 1 枚の HTML として、閲覧用サイトを生成すること"]
            n16["<b>FR-13</b> [FunctionalRequirement]<br/>図の初期表示でグラフ全体を 1 画面に収め、この表示は俯瞰の用途に限ること"]
            n17["<b>FR-14</b> [FunctionalRequirement]<br/>閲覧用サイトに表形式の一覧を設け、列見出しで並べ替えられるようにし、同値の行の…"]
            n18["<b>FR-15</b> [FunctionalRequirement]<br/>選択したノードと表示の絞り込みを URL に載せ、同じ画面を相手にも出せるよう…"]
            n19["<b>FR-16</b> [FunctionalRequirement]<br/>ノード数・エッジ数・充足率・曖昧語密度を数え、判定を伴わない形で出すこと"]
            n24["<b>FR-20</b> [FunctionalRequirement]<br/>MCP サーバとして validate / explain / impact …"]
            n27["<b>FR-23</b> [FunctionalRequirement]<br/>Graphviz のレイアウトを用いて SVG の図を書き出すこと"]
            n28["<b>FR-24</b> [FunctionalRequirement]<br/>記号だけが異なる id を持つノードを、図の上でも別のノードとして描き分けること"]
            n29["<b>FR-25</b> [FunctionalRequirement]<br/>源泉を図に描かず、参照元ノードの属性として引用文・位置・引用元まで出すこと"]
            n30["<b>FR-26</b> [FunctionalRequirement]<br/>選択したノードの近傍だけを図に描くフォーカス表示を設けること"]
            n39["<b>QR-1</b> [QualityRequirement]<br/>図に描かれるノードのラベルが読める倍率 (0.5 倍以上) を保つこと"]
            n40["<b>QR-3</b> [QualityRequirement]<br/>閲覧用サイトが書き出す図と CLI が出す図を、一字一句一致させること"]
            n41["<b>QR-4</b> [QualityRequirement]<br/>閲覧用サイトのすべての操作要素を、キーボードだけで辿れるようにすること"]
            n43[["<b>Constraint-2</b> [Constraint]<br/>実行時の依存を pydantic だけに保つこと"]]
            n45[["<b>Constraint-4</b> [Constraint]<br/>公開する閲覧用サイトを、外部への通信なしで表示できるようにすること"]]
        end
        subgraph group___unclassified__[未分類]
            direction TB
            n20["<b>FR-17</b> [FunctionalRequirement]<br/>正規化 JSON と Mermaid / DOT の図を出力すること"]
            n21["<b>FR-18</b> [FunctionalRequirement]<br/>構造差分と影響範囲を Mermaid 図付き Markdown で出力し、PR…"]
            n22["<b>FR-19</b> [FunctionalRequirement]<br/>プロジェクト固有の曖昧語と、検査ごとの有効・無効を設定ファイルで宣言できるよう…"]
            n25["<b>FR-21</b> [FunctionalRequirement]<br/>測定不能な QR・status の後退・id の命名規則違反を検査すること"]
            n26["<b>FR-22</b> [FunctionalRequirement]<br/>指摘を SARIF 形式で出力し、GitHub Code Scanning に…"]
        end
    end

